<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>PixelPress.App</AssemblyName>
    <RootNamespace>PixelPress.App</RootNamespace>
    <PackageId>pixel-press</PackageId>
    <Product>pixel-press</Product>
    <Authors>rwrife</Authors>
    <Company>rwrife</Company>
    <Description>Windows batch image resizer/converter/optimizer desktop utility.</Description>

    <WindowsPackageType>MSIX</WindowsPackageType>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PixelPress.Core\PixelPress.Core.csproj" />
  </ItemGroup>
</Project>
